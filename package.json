{
  "name": "university-ticketing-system",
  "private": true,
  "version": "0.2.0",
  "description": "Root project — orchestrates git hooks; backend (FastAPI) and frontend are independent apps.",
  "scripts": {
    "prepare": "husky",
    "setup": "bash scripts/setup.sh",
    "dev:backend": "cd backend && . .venv/bin/activate 2>/dev/null || true; uvicorn app.main:app --reload --port 4000",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7"
  },
  "lint-staged": {
    "backend/**/*.py": [
      "bash -c 'cd backend && ruff check --fix'"
    ],
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix frontend run lint -- --fix"
    ],
    "**/*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
