# Data source mode:
#   mock   — full fixture UI (no FastAPI). Safe for design work.
#   hybrid — live auth + chat + tickets + knowledge/FAQ + notifications.
#   api    — everything talks to FastAPI (unfinished slices degrade empty).
# Without a local .env, Vite falls back to mock and seeded API passwords
# (demo1234) will not work — copy this file to .env for testing against backend.
VITE_DATA_SOURCE=hybrid

# Backend base URL (used when auth/chat/tickets are live).
# Relative "/api/v1" goes through the Vite dev proxy below.
# Point it at an absolute URL when the backend runs elsewhere,
# e.g. http://100.94.185.71:4000/api/v1 over Tailscale.
VITE_API_BASE_URL=/api/v1

# WebSocket URL (used when backend WS is ready)
VITE_WS_URL=/ws

# Where the Vite dev proxy forwards /api and /ws
VITE_PROXY_TARGET=http://localhost:4000
VITE_WS_PROXY_TARGET=ws://localhost:4000
