ENVIRONMENT=development
PORT=4000

DATABASE_URL=postgresql+asyncpg://uts_user:uts_password@localhost:5432/university_ticketing

JWT_SECRET=replace-me-with-a-strong-secret
JWT_EXPIRES_IN=86400

CORS_ORIGIN=http://localhost:5173

# Local attachment storage (S3/MinIO deferred). Relative paths resolve from
# the process cwd — run uvicorn from `backend/` so files land in backend/uploads/.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# LDAP / SSO — pending IT confirmation (OI-01)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ── LLM ───────────────────────────────────────────────────────────────────────
# ollama | openai | google
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# Team default: GPU workstation Ollama via Tailscale Funnel (public HTTPS).
# Teammates do NOT need Tailscale, SSH, or a local Ollama install.
# Architecture: Funnel → Caddy (Bearer auth) → Ollama loopback on the GPU box.
# Get OLLAMA_API_KEY from the GPU runbook: print-credentials.sh (PUBLIC section)
#   or ~/ai-workspace/experiments/LLM Remote Call/PUBLIC_API.md
OLLAMA_OPENAI_BASE_URL=https://muc-a-3099.tail129a23.ts.net/v1
OLLAMA_API_KEY=replace-me
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=10m

# Embeddings (RAG ingest / retrieval). Same base URL + API key as chat.
# FaqEntry.embedding is Vector(768) — team default is Ollama nomic-embed-text.
# OpenAI text-embedding-3-small can pin dimensions=768 when LLM_PROVIDER=openai.
EMBEDDING_DIMENSIONS=768
# EMBEDDING_MODEL=          # optional override for any provider
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Optional: when developing ON the GPU host itself, you can override to loopback:
# OLLAMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama

# Alternative providers — set LLM_PROVIDER above to activate one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
