ENVIRONMENT=development
PORT=4000

DATABASE_URL=postgresql+asyncpg://uts_user:uts_password@localhost:5432/university_ticketing

JWT_SECRET=replace-me-with-a-strong-secret
JWT_EXPIRES_IN=86400

CORS_ORIGIN=http://localhost:5173

# LDAP / SSO — pending IT confirmation (OI-01)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ── LLM ───────────────────────────────────────────────────────────────────────
# ollama | openai | google
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# Ollama on the remote GPU box. It listens on the server's loopback only, so
# open a tunnel from this machine first:
#   ssh -N -L 11434:127.0.0.1:11434 rtx5090
# Running the backend in Docker? Use http://host.docker.internal:11434/v1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=10m

# Alternative providers — set LLM_PROVIDER above to activate one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
